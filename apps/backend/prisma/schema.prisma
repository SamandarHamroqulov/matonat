// This is your Prisma schema file for Matonat Education Center Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum NotificationType {
  ATTENDANCE
  PAYMENT
  ANNOUNCEMENT
  SYSTEM
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ─────────────────────────────────────────
// USER (Admin, Super Admin, Teacher)
// ─────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  fullName     String
  phone        String?
  avatar       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Teacher extended info
  teacherProfile TeacherProfile?

  // Relations
  refreshTokens    RefreshToken[]
  markedAttendances Attendance[]   @relation("MarkedBy")
  receivedPayments  Payment[]      @relation("ReceivedBy")
  notifications     Notification[]
  announcements     Announcement[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ─────────────────────────────────────────
// TEACHER PROFILE (extends User)
// ─────────────────────────────────────────

model TeacherProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  subject  String
  salary   Decimal @default(0) @db.Decimal(12, 2)
  hiredAt  DateTime @default(now())

  // Auto-generated login credentials (shown once)
  generatedLogin    String?
  generatedPassword String? // plain text, shown once then cleared

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups Group[]

  @@map("teacher_profiles")
}

// ─────────────────────────────────────────
// COURSE
// ─────────────────────────────────────────

model Course {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Decimal @db.Decimal(12, 2)
  duration    Int     // months
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups Group[]

  @@map("courses")
}

// ─────────────────────────────────────────
// GROUP
// ─────────────────────────────────────────

model Group {
  id        String   @id @default(cuid())
  name      String
  teacherId String
  courseId  String
  capacity  Int      @default(20)
  startDate DateTime
  endDate   DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher    TeacherProfile @relation(fields: [teacherId], references: [id])
  course     Course         @relation(fields: [courseId], references: [id])
  students   Student[]
  schedules  Schedule[]
  attendances Attendance[]

  @@index([teacherId])
  @@index([courseId])
  @@map("groups")
}

// ─────────────────────────────────────────
// SCHEDULE (dars jadvali)
// ─────────────────────────────────────────

model Schedule {
  id        String    @id @default(cuid())
  groupId   String
  dayOfWeek DayOfWeek
  startTime String    // "09:00"
  endTime   String    // "11:00"
  room      String?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("schedules")
}

// ─────────────────────────────────────────
// STUDENT
// ─────────────────────────────────────────

model Student {
  id          String   @id @default(cuid())
  fullName    String
  phone       String?
  parentPhone String
  birthDate   DateTime?
  groupId     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group        Group?         @relation(fields: [groupId], references: [id])
  attendances  Attendance[]
  payments     Payment[]
  telegramUser TelegramUser?

  @@index([groupId])
  @@index([parentPhone])
  @@map("students")
}

// ─────────────────────────────────────────
// ATTENDANCE (davomat)
// ─────────────────────────────────────────

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  groupId    String
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  note       String?
  markedById String
  createdAt  DateTime         @default(now())

  student  Student @relation(fields: [studentId], references: [id])
  group    Group   @relation(fields: [groupId], references: [id])
  markedBy User    @relation("MarkedBy", fields: [markedById], references: [id])

  @@unique([studentId, groupId, date])
  @@index([groupId, date])
  @@index([studentId])
  @@map("attendances")
}

// ─────────────────────────────────────────
// PAYMENT (to'lovlar)
// ─────────────────────────────────────────

model Payment {
  id           String        @id @default(cuid())
  studentId    String
  amount       Decimal       @db.Decimal(12, 2)
  month        DateTime      @db.Date // 2025-01-01 = January 2025
  method       PaymentMethod @default(CASH)
  note         String?
  paidAt       DateTime      @default(now())
  receivedById String

  student    Student @relation(fields: [studentId], references: [id])
  receivedBy User    @relation("ReceivedBy", fields: [receivedById], references: [id])

  @@index([studentId])
  @@index([month])
  @@map("payments")
}

// ─────────────────────────────────────────
// TELEGRAM USER (ota-onalar)
// ─────────────────────────────────────────

model TelegramUser {
  id         String   @id @default(cuid())
  telegramId String   @unique
  phone      String?
  firstName  String?
  lastName   String?
  studentId  String?  @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student? @relation(fields: [studentId], references: [id])

  @@index([telegramId])
  @@index([phone])
  @@map("telegram_users")
}

// ─────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────
// ANNOUNCEMENT (e'lonlar)
// ─────────────────────────────────────────

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  authorId    String
  sendToBot   Boolean  @default(false) // bot orqali ota-onalarga yuborilsinmi
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  author User @relation(fields: [authorId], references: [id])

  @@index([publishedAt])
  @@map("announcements")
}

// ─────────────────────────────────────────
// REFRESH TOKEN (auth security)
// ─────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // bcrypt hashed
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}
